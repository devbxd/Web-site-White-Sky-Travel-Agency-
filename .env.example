# Copy this file to .env for local development with `vercel dev`.
# In production, set LITEAPI_KEY in the Vercel project's Environment Variables
# instead (Project Settings -> Environment Variables). Never commit the real
# key to git.

# Get a free sandbox key at https://liteapi.travel/ (Developer -> API Keys).
# Starts with "sand_" for sandbox, "prod_" once you move to production.
LITEAPI_KEY=
